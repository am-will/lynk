# Copy to pc/.env.local (gitignored) so `npm run bridge` picks these up automatically.
# Real env vars set on the command line still win, so per-run overrides keep working.

PHONE_AGENT_HOST=0.0.0.0
PHONE_AGENT_PORT=8788
# Development-only USB self-healing. When enabled, the host bridge restores
# `adb reverse tcp:$PHONE_AGENT_PORT tcp:$PHONE_AGENT_PORT` for authorized devices.
# PHONE_AGENT_ADB_REVERSE=1
# Replace with the generated 64-character token from `npm run phone:tailscale` (or a
# 32+ character high-entropy shared secret you also save in Android). Both ends must
# match exactly. A weak token is rejected unless the bridge is deliberately isolated
# and PHONE_AGENT_ALLOW_UNSAFE_DEVELOPMENT=1 is set for that development run.
PHONE_AGENT_TOKEN=replace-with-strong-token
# PHONE_AGENT_ALLOW_UNSAFE_DEVELOPMENT=1
# Comma-separated externally TLS-terminated phone endpoints. The bridge itself is
# plain HTTP by default; do not advertise wss unless a reverse proxy or platform
# TLS service actually terminates it and forwards /phone to this bridge.
# PHONE_AGENT_PAIRING_WSS_URLS=wss://lynk.example.com/phone
# Explicit development exception for a private Tailscale overlay. This advertises
# ws:// Tailscale endpoints; Android will never send provider API keys over them.
# PHONE_AGENT_PAIRING_ALLOW_INSECURE_TAILSCALE=1
PHONE_AGENT_DEFAULT_DEVICE=openclaw-agent
PHONE_AGENT_BRIDGE_URL=http://127.0.0.1:8788
# Primary legacy dispatcher for user_request fallback paths. Chat UI harnesses are selected
# from the Android model picker and can use OpenClaw, Hermes, or Codex in one bridge.
PHONE_AGENT_DISPATCHER=openclaw
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# Optional if the bridge cannot read Gateway auth from OPENCLAW_CONFIG_PATH or ~/.openclaw/openclaw.json.
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_PASSWORD=
OPENCLAW_CHAT_AGENT_ID=main
OPENCLAW_CHAT_SESSION_KEY=agent:main:explicit:open-claw-agent
OPENCLAW_AGENT_COMMAND=openclaw
OPENCLAW_AGENT_SESSION_ID=open-claw-agent
OPENCLAW_AGENT_TIMEOUT_SECONDS=600
# Optional Hermes harness. When HERMES_API_KEY is set, Hermes models appear in the
# Android model picker as separate Hermes entries and use isolated Hermes chat history.
HERMES_API_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_DEFAULT_SESSION_ID=hermes-agent
HERMES_RUN_TIMEOUT_SECONDS=600
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
OPENAI_WEB_SEARCH_MODEL=gpt-5.5
CODEX_APP_SERVER_COMMAND=codex app-server --listen stdio://
CODEX_AGENT_CWD=..
# Codex app-server thread permissions. Use danger-full-access only for trusted local use.
CODEX_APP_SERVER_APPROVAL_POLICY=never
CODEX_APP_SERVER_SANDBOX=workspace-write
# Optional OpenCode harness. Leave OPENCODE_SERVER_URL blank to let Lynk start
# `opencode serve` locally; set it to reuse an already-running private server.
OPENCODE_SERVER_URL=
OPENCODE_SERVER_COMMAND=opencode serve --hostname 127.0.0.1 --port 4096
OPENCODE_AGENT_CWD=..
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_DEFAULT_AGENT=
OPENCODE_RUN_TIMEOUT_SECONDS=600
# Optional Pi harness. Pi uses its SDK and stores sessions under PI_AGENT_DIR
# when set, otherwise the SDK default ~/.pi/agent is used.
PI_AGENT_CWD=..
PI_AGENT_DIR=
PI_DEFAULT_MODEL=
PI_RUN_TIMEOUT_SECONDS=600
# Optional Devin harness. Devin uses its official CLI in ACP stdio mode.
DEVIN_ACP_COMMAND=devin acp
DEVIN_AGENT_CWD=..
DEVIN_RUN_TIMEOUT_SECONDS=600
# Optional: accept-edits, ask, plan, or bypass. Bypass auto-approves every Devin tool call.
DEVIN_PERMISSION_MODE=
