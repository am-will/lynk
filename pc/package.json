{
  "name": "lynk-bridge",
  "version": "0.1.0",
  "description": "Host bridge companion for the Lynk Android agent endpoint.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "bin": {
    "lynk-bridge": "dist/bin/lynk-bridge.js",
    "lynk-bridge-host": "dist/bin/lynk-bridge-host.js",
    "lynk-bridge-mcp": "dist/bin/lynk-bridge-mcp.js"
  },
  "files": [
    "dist/",
    "installers/",
    ".env.example",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "bridge": "tsx --env-file-if-exists=.env.local src/bridge/server.ts",
    "bridge:dist": "node dist/bridge/server.js",
    "mcp": "tsx --env-file-if-exists=.env.local src/mcp/androidPhoneServer.ts",
    "openclaw:mcp": "tsx --env-file-if-exists=.env.local src/scripts/configureOpenClawMcp.ts",
    "hermes:mcp": "tsx --env-file-if-exists=.env.local src/scripts/configureHermesMcp.ts",
    "codex:mcp": "tsx --env-file-if-exists=.env.local src/scripts/configureCodexMcp.ts",
    "phone:usb": "adb reverse tcp:8788 tcp:8788 && adb shell monkey -p app.lynk 1",
    "phone:tailscale": "tsx --env-file-if-exists=.env.local src/scripts/printTailscalePairing.ts",
    "phone:health": "curl -sS http://127.0.0.1:8788/health",
    "host:pairing": "tsx --env-file-if-exists=.env.local src/host/cli.ts pairing",
    "host:pairing:qr": "tsx --env-file-if-exists=.env.local src/host/cli.ts pairing --qr",
    "host:refresh": "tsx --env-file-if-exists=.env.local src/host/cli.ts refresh",
    "host:mcp": "tsx --env-file-if-exists=.env.local src/host/cli.ts mcp",
    "host:service-plan": "tsx --env-file-if-exists=.env.local src/host/cli.ts service-plan",
    "host:diagnostics": "tsx --env-file-if-exists=.env.local src/host/cli.ts diagnostics",
    "demo:open-settings": "tsx --env-file-if-exists=.env.local src/scripts/sendCommand.ts open_app '{\"appName\":\"Settings\"}'",
    "demo:agent": "tsx --env-file-if-exists=.env.local src/scripts/sendUserRequest.ts",
    "codex:schemas": "codex app-server generate-ts --out src/generated/codex-app-server",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.20.6",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
